{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "mkdir -p merchant/dist && vite build && esbuild server.ts --platform=node --format=esm --outfile=server.js --packages=external",
    "start": "node server.js",
    "clean": "rm -rf merchant/dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "firebase": "^10.12.0",
    "lucide-react": "^0.400.0",
    "motion": "^11.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "vite": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.21.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.0",
    "@types/express": "^4.17.21"
  }
}
